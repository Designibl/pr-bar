#!/usr/bin/env python3
"""Poll GitHub via the gh CLI and write the PR cache. Run by the launch agent."""
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import prbar_common as c  # noqa: E402

QUERY = """
query($q: String!) {
  search(query: $q, type: ISSUE, first: 50) {
    nodes {
      ... on PullRequest {
        id number title url isDraft body headRefName updatedAt
        additions deletions changedFiles
        mergeable mergeStateStatus reviewDecision
        author { login }
        repository { nameWithOwner }
        commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state } } } }
        comments(last: 30) { nodes { body } }
        reviewThreads(first: 100) { nodes { isResolved } }
      }
    }
  }
}
"""


def gh(*args):
    env = dict(os.environ, PATH=c.full_path(), GH_PROMPT_DISABLED="1")
    res = subprocess.run(["gh", *args], capture_output=True, text=True, env=env, timeout=120)
    if res.returncode != 0:
        raise RuntimeError((res.stderr or res.stdout).strip() or "gh failed")
    return res.stdout


def search(q):
    data = json.loads(gh("api", "graphql", "-f", "query=" + QUERY, "-f", "q=" + q))
    return [n for n in data["data"]["search"]["nodes"] if n]


def my_teams():
    """'org/slug' for each team I'm in; empty if the token can't list them (needs read:org)."""
    try:
        data = json.loads(gh("api", "user/teams", "--paginate", "--slurp"))
        return sorted("%s/%s" % (t["organization"]["login"], t["slug"]) for page in data for t in page)
    except Exception:
        return []


def review_requests(login):
    """[(node, via)] for open PRs awaiting my review: asked directly, or via a team I'm in."""
    found = {}

    def add(nodes, via):
        for n in nodes:
            entry = found.setdefault(n["id"], (n, []))
            if via not in entry[1]:
                entry[1].append(via)

    add(search("is:pr is:open archived:false user-review-requested:%s -author:%s sort:updated-desc"
               % (login, login)), c.YOU)
    for team in my_teams():
        try:
            add(search("is:pr is:open archived:false team-review-requested:%s -author:%s sort:updated-desc"
                       % (team, login)), team)
        except Exception:
            continue  # a team the token can't search shouldn't fail the whole poll
    return list(found.values())


def required_failures(nodes):
    """Set `_ci_blocking` on PRs whose rollup is failing: True if a *required* check fails.

    If the branch has no required checks at all, any failure counts as blocking.
    """
    def rollup_state(n):
        commit = ((n.get("commits") or {}).get("nodes") or [{}])[0].get("commit") or {}
        return (commit.get("statusCheckRollup") or {}).get("state")

    failing = [n for n in nodes if rollup_state(n) in ("FAILURE", "ERROR")]
    if not failing:
        return
    parts = []
    for i, n in enumerate(failing):
        parts.append(
            'p%d: node(id: "%s") { ... on PullRequest { commits(last: 1) { nodes { commit { statusCheckRollup {'
            ' contexts(first: 100) { nodes { __typename'
            ' ... on CheckRun { conclusion isRequired(pullRequestId: "%s") }'
            ' ... on StatusContext { state isRequired(pullRequestId: "%s") } } } } } } } } }'
            % (i, n["id"], n["id"], n["id"])
        )
    try:
        data = json.loads(gh("api", "graphql", "-f", "query=query { %s }" % " ".join(parts)))["data"]
    except Exception:
        return  # fall back to treating any failure as blocking
    bad = ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "STARTUP_FAILURE", "ACTION_REQUIRED")
    for i, n in enumerate(failing):
        try:
            ctxs = data["p%d" % i]["commits"]["nodes"][0]["commit"]["statusCheckRollup"]["contexts"]["nodes"]
        except (KeyError, TypeError, IndexError):
            continue
        required = [x for x in ctxs if x and x.get("isRequired")]
        n["_ci_blocking"] = (
            any((x.get("conclusion") or x.get("state")) in bad for x in required) if required else True
        )


def commits_behind():
    """How many commits origin/main is ahead of this clone; None if unknown."""
    try:
        git = ["/usr/bin/git", "-C", str(c.ROOT)]
        subprocess.run(git + ["fetch", "-q", "origin", "main"], capture_output=True, timeout=30, check=True)
        out = subprocess.run(git + ["rev-list", "--count", "HEAD..origin/main"],
                             capture_output=True, text=True, timeout=10, check=True).stdout
        return int(out.strip())
    except Exception:
        return None


def write_cache(payload):
    c.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(c.CONFIG_DIR))
    with os.fdopen(fd, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, str(c.CACHE_FILE))


def main():
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        login = gh("api", "user", "--jq", ".login").strip()
        mine = search("is:pr is:open archived:false author:%s sort:updated-desc" % login)
        asked = review_requests(login)
        required_failures(mine)
        prs = [c.normalise(n) for n in mine] + [c.normalise(n, True, via) for n, via in asked]
        write_cache({"fetched_at": now, "login": login, "prs": prs, "error": None,
                     "update_behind": commits_behind()})
    except Exception as exc:  # keep stale data, surface the error in the menu
        old = c.load_cache() or {"prs": [], "login": None, "fetched_at": None}
        old["error"] = str(exc)[:300]
        old["error_at"] = now
        write_cache(old)
        print("prbar-fetch: %s" % exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
