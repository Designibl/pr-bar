#!/usr/bin/env python3
"""Actions invoked from the SwiftBar menu.

Usage:
  prbar-ctl refresh
  prbar-ctl update                   (git pull this clone, reload agent)
  prbar-ctl set-interval <seconds>
  prbar-ctl install-agent            (write + load the launch agent)
  prbar-ctl uninstall-agent
  prbar-ctl copy <md|slack|text> <all|review|mine-review>
  prbar-ctl toggle-agent <binary>
  prbar-ctl review <binary> <pr-url>
  prbar-ctl session <binary>
"""
import os
import plistlib
import shutil
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import prbar_common as c  # noqa: E402

FETCH = str(c.BIN / "prbar-fetch")


def run(*cmd, **kw):
    return subprocess.run(list(cmd), capture_output=True, text=True, **kw)


def swiftbar_refresh():
    run("open", "-g", "swiftbar://refreshallplugins")


def notify(msg):
    run("osascript", "-e", 'display notification %s with title "PR Bar"' % _as(msg))


def _as(s):
    return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"')


def sync_agent_scripts():
    """Copy the fetch scripts out of the clone so launchd never reads a TCC-protected folder
    (Documents, Desktop, iCloud...) which it is denied access to."""
    dest = c.CONFIG_DIR / "agent"
    dest.mkdir(parents=True, exist_ok=True)
    for name in ("prbar-fetch", "prbar_common.py"):
        shutil.copy2(c.BIN / name, dest / name)
    return str(dest / "prbar-fetch")


def write_plist(interval):
    c.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    c.PLIST.parent.mkdir(parents=True, exist_ok=True)
    data = {
        "Label": c.LABEL,
        "ProgramArguments": ["/usr/bin/python3", sync_agent_scripts()],
        "StartInterval": int(interval),
        "RunAtLoad": True,
        "EnvironmentVariables": {"PATH": c.full_path(), "PRBAR_ROOT": str(c.ROOT)},
        "StandardErrorPath": str(c.CONFIG_DIR / "fetch.log"),
        "StandardOutPath": str(c.CONFIG_DIR / "fetch.log"),
    }
    with open(c.PLIST, "wb") as f:
        plistlib.dump(data, f)


def load_agent():
    domain = "gui/%d" % os.getuid()
    run("launchctl", "bootout", "%s/%s" % (domain, c.LABEL))
    res = run("launchctl", "bootstrap", domain, str(c.PLIST))
    if res.returncode != 0:
        print(res.stderr, file=sys.stderr)
    return res.returncode


def terminal_run(command):
    """Run a shell command in a new Terminal.app window."""
    script = 'tell application "Terminal"\nactivate\ndo script %s\nend tell' % _as(command)
    run("osascript", "-e", script)


def git(*args):
    return run("/usr/bin/git", "-C", str(c.ROOT), *args)


def update_self():
    """Fast-forward this clone to origin/main and reload the launch agent."""
    if git("rev-parse", "--is-inside-work-tree").returncode != 0:
        return "Not a git clone; update manually."
    if git("status", "--porcelain").stdout.strip():
        return "Update skipped: local changes in the clone."
    if git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() != "main":
        return "Update skipped: clone is not on main."
    old = c.version()
    res = git("pull", "--ff-only", "origin", "main")
    if res.returncode != 0:
        return "Update failed: " + (res.stderr.strip().splitlines() or ["git pull"])[-1]
    write_plist(c.load_config()["interval"])
    load_agent()
    run("/usr/bin/python3", FETCH)
    new = c.version()
    return "Updated %s -> %s" % (old, new) if new != old else "Already up to date (v%s)" % new


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]

    if cmd == "refresh":
        run("/usr/bin/python3", FETCH)
        swiftbar_refresh()
    elif cmd == "update":
        notify(update_self())
        swiftbar_refresh()
    elif cmd == "set-interval":
        cfg = c.load_config()
        cfg["interval"] = int(args[0])
        c.save_config(cfg)
        write_plist(cfg["interval"])
        load_agent()
        swiftbar_refresh()
    elif cmd == "install-agent":
        write_plist(c.load_config()["interval"])
        return load_agent()
    elif cmd == "uninstall-agent":
        run("launchctl", "bootout", "gui/%d/%s" % (os.getuid(), c.LABEL))
        if c.PLIST.exists():
            c.PLIST.unlink()
    elif cmd == "copy":
        fmt, scope = args[0], args[1]
        cache = c.load_cache() or {"prs": []}
        text = c.format_summary(cache["prs"], fmt, scope)
        subprocess.run(["pbcopy"], input=text, text=True)
        notify("Copied %s summary (%s)" % (fmt, scope))
    elif cmd == "toggle-agent":
        cfg = c.load_config()
        dis = set(cfg.get("disabled_agents", []))
        dis ^= {args[0]}
        cfg["disabled_agents"] = sorted(dis)
        c.save_config(cfg)
        swiftbar_refresh()
    elif cmd == "review":
        key, url = args[0], args[1]
        binary = c.resolve_agent(key) or key
        prompt = (
            "Review pull request %s. Use the gh CLI to read the description, diff, "
            "CI status and existing comments, then give me concise, actionable review feedback." % url
        )
        if key in c.INTERACTIVE:
            # Can't pass a prompt in: open it in the PR's repo and put the prompt on the clipboard.
            repo = "/".join(url.split("/")[3:5])
            subprocess.run(["pbcopy"], input=prompt, text=True)
            terminal_run("cd %s && %s" % (shlex.quote(c.find_repo_dir(repo) or os.path.expanduser("~")),
                                          shlex.quote(binary)))
            notify("Review prompt copied - paste it into a new %s session" % c.AGENTS[key])
        else:
            terminal_run("%s %s" % (shlex.quote(binary), shlex.quote(prompt)))
    elif cmd == "session":
        key = args[0]
        binary = c.resolve_agent(key) or key
        if key in c.INTERACTIVE:
            prs = (c.load_cache() or {}).get("prs", [])
            mine = [p for p in prs if not p["review_requested"]] or prs
            where = (mine and c.find_repo_dir(mine[0]["repo"])) or os.path.expanduser("~")
            terminal_run("cd %s && %s" % (shlex.quote(where), shlex.quote(binary)))
        else:
            terminal_run(shlex.quote(binary))
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
